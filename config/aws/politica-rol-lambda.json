{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccesoShadow",
      "Effect": "Allow",
      "Action": [
        "iot:GetThingShadow",
        "iot:UpdateThingShadow",
        "iot:DescribeThing"
      ],
      "Resource": "arn:aws:iot:us-east-1:<ID_CUENTA>:thing/caja-enigmas-*"
    },
    {
      "Sid": "AccesoDynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:<ID_CUENTA>:table/CajaEnigmasVinculaciones"
    },
    {
      "Sid": "PublicarEventosPistas",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:us-east-1:<ID_CUENTA>:topic/caja-enigmas/caja-enigmas-*/eventos"
    }
  ]
}
