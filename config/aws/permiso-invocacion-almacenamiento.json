{
  "Version": "2012-10-17",
  "Id": "default",
  "Statement": [
    {
      "Sid": "CajaEnigmasLecturas",
      "Effect": "Allow",
      "Principal": {
        "Service": "iot.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:<ID_CUENTA>:function:caja-enigmas-almacenamiento",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:iot:us-east-1:<ID_CUENTA>:rule/CajaEnigmasLecturas"
        }
      }
    },
    {
      "Sid": "CajaEnigmasEventos",
      "Effect": "Allow",
      "Principal": {
        "Service": "iot.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:<ID_CUENTA>:function:caja-enigmas-almacenamiento",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:iot:us-east-1:<ID_CUENTA>:rule/CajaEnigmasEventos"
        }
      }
    }
  ]
}
